# Google Cloud Console で作成した OAuth クライアント（ウェブ アプリケーション）の情報
# https://console.cloud.google.com/apis/credentials
google_health:
  client_id: ""
  client_secret: ""
  redirect_uri: "http://localhost:8080/callback"

# HealthPlanet API設定
# https://www.healthplanet.jp/apis/api.do
healthplanet:
  client_id: ""
  client_secret: ""
  redirect_uri: "http://localhost:8080/callback"

# 同期設定
sync:
  # デフォルトの同期日数（直近N日分）
  default_days: 7
