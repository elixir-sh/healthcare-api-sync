# Google Cloud Console で作成した OAuth クライアント（ウェブ アプリケーション）の情報
# https://console.cloud.google.com/apis/credentials
google_health:
  client_id: ""
  client_secret: ""
  redirect_uri: "http://localhost:8080/callback"

# HealthPlanet API設定
# https://www.healthplanet.jp/apis/api.do
healthplanet:
  client_id: ""
  client_secret: ""
  redirect_uri: "http://localhost:8080/callback"

# Notion の体重データベース（任意。すべて空なら Notion への書き込みを飛ばす）
# 認証は token（内部インテグレーション）か client_id / client_secret（OAuth）のどちらかを記入する（README 参照）
notion:
  weight_data_source_id: ""
  # 内部インテグレーションのトークン。記入すると OAuth より優先する
  token: ""
  # OAuth のコネクト。記入後に `uv run python main.py auth notion` で認証する
  client_id: ""
  client_secret: ""
  redirect_uri: "http://localhost:8080/callback"

# 同期設定
sync:
  # デフォルトの同期日数（直近N日分）
  default_days: 7
